# GoHighLevel Inbound Webhook URL.
# Set this in Vercel → Project → Settings → Environment Variables.
# Get the URL from GHL: Automation → Workflows → New Workflow →
#   Trigger: "Inbound Webhook" → copy the URL it generates.
# All routing/tagging/SMS logic lives in that workflow.
GHL_LEAD_WEBHOOK=

# Existing variable used by api/contact.js (for the /contact-us page form).
GHL_CONTACT_WEBHOOK=

# ── Internal ads dashboard (/dashboard) ──────────────────────────────────────
# All four are read ONLY by the serverless functions. None is ever sent to the
# browser. Set them in Vercel → Project → Settings → Environment Variables.

# Meta System User token with the ads_read scope. Create it in
# business.facebook.com → Business Settings → Users → System Users →
# Generate New Token. The System User must also be assigned the ad account
# with "View Performance" under Assign Assets.
META_ADS_TOKEN=

# Ad account id, including the act_ prefix.
META_AD_ACCOUNT_ID=

# Password for the dashboard login wall. Choose a long one — the in-function
# throttle is best-effort only, because serverless instances are ephemeral.
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie. Generate your own and never share it;
# anyone holding it can forge a valid session. e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=

# Optional. Graph API version, e.g. v23.0. Only set this if Meta reports the
# default version as unsupported — the endpoint will say so explicitly.
META_API_VERSION=
